# Copy to .env for local development. PLACEHOLDERS ONLY - never commit real secrets.

APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
METRICS_ADDR=:9090

# Set when running binaries directly (docker compose overrides these).
DATABASE_URL=postgres://wallet:wallet@127.0.0.1:5432/wallet?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0

# >= 32 random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-0000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Phone verification. SMS_MODE=log prints one-time codes to the server log
# (development only; refused when APP_ENV=production).
REQUIRE_PHONE_VERIFICATION=true
SMS_MODE=log

# simulated = deterministic local provider, no real money (refused in production)
# live      = real provider APIs (sandbox or production per provider below)
PAYMENTS_MODE=simulated
DEPOSIT_EXPIRY=3m

# Required in live mode: public HTTPS origin and a high-entropy callback path secret.
PUBLIC_BASE_URL=
CALLBACK_TOKEN=
TRUST_PROXY_HEADERS=false

# --- M-Pesa Daraja (live mode) ---
MPESA_ENABLED=false
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PARTY_B=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_CERT_PATH=
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_CALLBACK_ALLOWLIST=

# --- Airtel Money (live mode) ---
AIRTEL_ENABLED=false
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=KE
AIRTEL_CURRENCY=KES
AIRTEL_DISBURSEMENT_PIN=
AIRTEL_PUBLIC_KEY=
AIRTEL_CALLBACK_ALLOWLIST=

# Exact browser origins allowed to call the API (web admin console), comma separated.
CORS_ALLOWED_ORIGINS=
